{
  "name": "cso-repository",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "test:worker": "npm --prefix worker test",
    "test:rules": "npx firebase emulators:exec --only firestore --project demo-cso \"node --test --test-concurrency=1 test/rules/*.test.js\"",
    "deploy:worker": "npm --prefix worker run deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.19.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "rc",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "prettier": "3.9.5",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "rc",
    "@vue/compiler-core": "rc",
    "@vue/compiler-dom": "rc",
    "@vue/compiler-sfc": "rc",
    "@vue/compiler-ssr": "rc",
    "@vue/compiler-vapor": "rc",
    "@vue/reactivity": "rc",
    "@vue/runtime-core": "rc",
    "@vue/runtime-dom": "rc",
    "@vue/runtime-vapor": "rc",
    "@vue/server-renderer": "rc",
    "@vue/shared": "rc",
    "@vue/compat": "rc"
  }
}
